<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>com.centinela</groupId>
    <artifactId>centinela</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>centinela</name>
    <description>Motor de deteccion de fraude transaccional - Semana 1 (ingesta cruda)</description>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.3.0</archunit.version>
        <azure-sdk-bom.version>1.2.31</azure-sdk-bom.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Alinea las versiones de todo el SDK de Azure sin fijarlas una por una. -->
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${azure-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- API HTTP (endpoints en ISS-007). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (validaciones de contrato en ISS-007). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Seguridad HTTP como resource server (ISS-011). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Health checks para HA y smoke tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JPA para persistencia de casos (Semana 2). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-queue</artifactId>
        </dependency>

        <!--
          Lectura del registro de scoring por el explicador de casos (Semana 3).
          El detalle de activacion vive en Cosmos DB for MongoDB junto a la transaccion;
          el mensaje de cola solo transporta un resumen.
        -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>5.2.1</version>
        </dependency>

        <!--
          Extraccion documental ejecutada dentro del componente (plan alternativo del
          enunciado cuando el servicio administrado de reconocimiento no esta disponible
          en la suscripcion). No incluye OCR: un escaneo sin capa de texto se reporta
          como ilegible en vez de devolver campos vacios.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
        </dependency>

        <!-- Publicacion del evento de transaccion en Event Grid (ISS-S2-006).
             Version gestionada por azure-sdk-bom; autenticacion por Managed
             Identity via DefaultAzureCredential (sin claves versionadas). -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-messaging-eventgrid</artifactId>
        </dependency>

        <!-- Pruebas. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test de arquitectura hexagonal. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Migraciones versionadas del esquema de casos. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Plugin JDBC oficial para obtener token Entra/Managed Identity sin password. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity-extensions</artifactId>
            <version>1.2.0</version>
        </dependency>

        <!-- FEAT-S2-001: Base de datos en memoria para tests de integracion. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Ejecuta las pruebas de integracion (*IT) en la fase verify. Las IT
                 contra Azure real estan protegidas con @EnabledIfEnvironmentVariable
                 (CENTINELA_RUN_AZURE_IT / CENTINELA_RUN_AZURE_DOCUMENT_IT), por lo que
                 se omiten cuando no hay suscripcion; las IT MockMvc (401/403/202/201)
                 corren siempre y cierran las pruebas posteriores locales de Semana 1. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
