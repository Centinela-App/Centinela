# === Secretos y configuracion local (NUNCA se commitean) ===
.env
*.env
!.env.example
/env
*.pem
*.key
*secret*
# Excepcion: el auditor de secretos (ISS-S2-003) lleva "secret" en el nombre pero
# NO contiene secretos; es un script de prueba versionado.
!scripts/tests/audit-git-secrets.sh

# === Build / Maven ===
target/

# === IDE ===
.idea/
*.iml

# === Logs y temporales ===
*.log
# Registros locales de scripts/deploy-all.sh y de los runbooks de evidencia.
deploy-run/
evidence-run/
# Excepcion: los logs de evidencia SANITIZADOS de la prueba de cierre (ISS-S1-014)
# si se versionan (deployment.log, cleanup.log bajo docs/evidence/final/<runId>/).
!docs/evidence/**/*.log
