{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensions": {
    "eventGrid": {
      "maxEventsPerBatch": 1
    }
  },
  "customHandler": {
    "description": {
      "defaultExecutablePath": ""
    }
  },
  "scoringSettings": {
    "scoringThreshold": 50,
    "riskyMerchants": ["Casino Royal", "BetCrypto", "RiskyStore"],
    "riskyCategories": ["gambling", "crypto", "pawn_shop"]
  },
  "functionTimeout": "00:05:00"
}
